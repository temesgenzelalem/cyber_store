<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ⚠️  This file is a TEMPLATE.
  After running `flutterfire configure`, the real Info.plist will be auto-generated.
  Add the keys below to the generated file manually if they are missing.
-->
<plist version="1.0">
<dict>
    <!-- ── App identity ── -->
    <key>CFBundleDevelopmentRegion</key>  <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>        <string>cyber</string>
    <key>CFBundleExecutable</key>         <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>         <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key>               <string>cyber_store</string>
    <key>NSCameraUsageDescription</key>
    <string>Camera is needed for AR visualization of gadgets.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Microphone is needed for Amharic Voice Search.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Speech recognition is needed for Voice Search.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Photo library is needed to upload product images and avatars.</string>
    <key>CFBundlePackageType</key>        <string>APPL</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>cyberstore</string>
            </array>
        </dict>
    </array>
    <key>CFBundleShortVersionString</key> <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>          <string>????</string>
    <key>CFBundleVersion</key>            <string>$(FLUTTER_BUILD_NUMBER)</string>

    <!-- ── Orientation ── -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- ── Required for camera (product image upload, optional) ── -->
    <key>NSCameraUsageDescription</key>
    <string>cyber uses your camera to upload product photos.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>cyber needs photo access to upload your profile picture.</string>

    <!-- ── Network ── -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key><false/>
        <key>NSAllowsArbitraryLoadsInWebContent</key><true/>
    </dict>

    <!-- ── Flutter ── -->
    <key>CADisableMinimumFrameDurationOnPhone</key><true/>
    <key>UIApplicationSupportsIndirectInputEvents</key><true/>

    <!-- ── Firebase: replace with your GoogleService-Info.plist CLIENT_ID ── -->
    <!-- This is auto-populated by flutterfire configure -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key><string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>YOUR_REVERSED_CLIENT_ID</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
